import bluetooth

TARGET = "F4:B6:2D:AE:AB:E0"

for ch in range(1, 16):
    try:
        sock = bluetooth.BluetoothSocket(bluetooth.RFCOMM)
        sock.connect((TARGET, ch))
        print(f"Channel {ch}: CONNECTED")
        sock.close()
    except Exception as e:
        print(f"Channel {ch}: {e}")

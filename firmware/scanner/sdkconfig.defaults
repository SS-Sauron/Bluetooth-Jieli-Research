# Enable Classic BT and BLE dual mode
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_ESP_COEX_ENABLED=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
CONFIG_BT_BLUEDROID_ESP_COEX_VSC=y
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
CONFIG_BT_BTU_TASK_STACK_SIZE=4352

# Reduce IRAM usage (needed for Wi-Fi + Bluetooth coexistence)
CONFIG_ESP32_WIFI_IRAM_OPT=n
CONFIG_ESP32_WIFI_RX_IRAM_OPT=n

# To enable/disable NRF24L01+PA+LNA comment/uncomment the line below
# CONFIG_SCANNER_NRF24=y
